#include <winver.h>

#ifndef NV_VERSION_MAJOR
#define NV_VERSION_MAJOR 1
#define NV_VERSION_MINOR 0
#define NV_VERSION_BUILD 0
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION NV_VERSION_MAJOR,NV_VERSION_MINOR,NV_VERSION_BUILD,0
PRODUCTVERSION NV_VERSION_MAJOR,NV_VERSION_MINOR,NV_VERSION_BUILD,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "FarNitroView - image viewer plugin for Far Manager 3 (jpeg-nitro decoders)"
      VALUE "InternalName", "FarNitroView"
      VALUE "OriginalFilename", "FarNitroView.dll"
      VALUE "ProductName", "FarNitroView for Far Manager"
      VALUE "CompanyName", "github.com/danzig666/farnitroview"
      VALUE "LegalCopyright", "MIT License; jpeg-nitro (c) 2026 A'rpi, MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
